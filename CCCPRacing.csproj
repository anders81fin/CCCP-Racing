<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CCCPRacing</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="native/export-window/linux-x86_64.so" LogicalName="CCCPRacing.Export.HiddenWindow.x64" />
    <!-- Build artifacts may include archived diagnostic source files. -->
    <Compile Remove="build/**/*.cs" />
    <Compile Remove="media/**/*.cs" />
  </ItemGroup>
  <!-- A release build (what Godot exports) leaves out the development-only test code. Its hooks in production code are
       partial methods (src/Race/RaceScene.DevHooks.cs), which vanish without an implementation. Build it with
       dotnet build CCCPRacing.csproj -c ExportRelease (the .sln has no such configuration). -->
  <!-- CS0649 in a release build: test seams in production classes (fields named ...ForTest, TestWire and the like) that only the
       left-out test files assign. The development build still reports a field nobody assigns. -->
  <PropertyGroup Condition="'$(Configuration)'=='ExportRelease'">
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)'=='ExportRelease'">
    <Compile Remove="src/Tests/**" />
    <Compile Remove="src/Race/RaceScene.ViewerWindowed*.cs" />
    <Compile Remove="src/Race/RaceScene.Viewer*Test.cs" />
    <Compile Remove="src/Race/RaceScene.ViewerSpike.cs;src/Race/RaceScene.ViewerFreeze.cs" />
    <Compile Remove="src/Race/RaceScene.Lan*Test.cs" />
  </ItemGroup>
</Project>
