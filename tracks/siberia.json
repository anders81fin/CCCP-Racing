{
  // SIBERIA IN WINTER - track 2 of the five-year plan (2026-10-06 layout draft for the map review).
  // Driven anticlockwise, unlike Ilyich and the bonus track: left-handers rule. The start is in the
  // south valley; the start straight crosses the frozen river at once, a fast left sweep climbs to
  // the east hill, switchbacks go up it, over the top to the airbase, west along the runway, down
  // the west side, onto the frozen river for a long fast slide downstream, a hairpin back onto the
  // bank and through the gulag camp gate, a last left onto the start straight.
  // Packed snow on the road, deep snow off it, glare ice on the frozen river and black ice patches
  // on the snow road; the runway is ploughed concrete.
  "id": "siberia",
  // Siberia: short middle gears for snowy climbs; about 39/57/78/102/138 km/h.
  "gearbox": { "gears": [4.15, 2.85, 2.1, 1.6, 1.18], "finalDrive": 5.5, "shiftDown": 3500 },
  "name": "SIBLAG NO.2 FIVE YEARS IN FOUR",
  // The rally's norms: 1:35 down to 1:10 (the user's choice, 2026-10-13; even 3 s / 2.5 s steps; the
  // autopilot laps the empty road in ~96 s, ~1:55 in traffic). Bronze for 4 norms beaten, silver for 7, gold for the plan.
  "norms": { "ladder": [89, 86, 83, 80, 77, 74, 71, 68, 65, 62], "dieselLadder": [90, 87, 84, 81, 78, 75, 72, 69, 66, 63], "bronze": 4, "silver": 7, "diesel": 1.02, "rocket": 0.97 },
  "size": 160,
  "tileSize": 2.0,
  "seed": 1937,
  "hillAmp": 3.0,
  "hillScale": 90.0,
  "birches": 160,
  "ground": "deepsnow",
  "edgeRim": 8,
  // The land rises from the river valley in the south to the airbase plateau in the north; the
  // east slope (a ridge reaching south from the plateau) carries the switchbacks, climbing all the way.
  "hills": [
    { "x": 50, "z": 30, "x1": 270, "z1": 30, "height": 9, "radius": 110, "calm": 0.8 },
    { "x": 268, "z": 50, "x1": 268, "z1": 135, "height": 9, "radius": 75, "calm": 0.8 },
    { "x": 240, "z": 305, "x1": 60, "z1": 305, "height": -3, "radius": 45, "calm": 0.9 }
  ],
  "points": [
    // 1 the start straight in the south valley (the frozen river is crossed at ~120 m)
    { "x": 95,  "z": 290, "width": 12, "surface": "snow" },
    { "x": 150, "z": 292, "width": 12, "surface": "snow" },
    { "x": 205, "z": 288, "width": 12, "surface": "snow" },
    { "x": 255, "z": 280, "width": 11, "surface": "snow" },
    // 2 the fast left sweep up to the east hill
    { "x": 290, "z": 255, "width": 11, "surface": "snow" },
    { "x": 300, "z": 222, "width": 10, "surface": "snow" },
    // 3 the switchbacks up the hill
    { "x": 258, "z": 212, "width": 9,  "surface": "snow" },
    { "x": 226, "z": 200, "width": 9,  "surface": "snow" },
    { "x": 244, "z": 184, "width": 9,  "surface": "snow" },
    { "x": 292, "z": 172, "width": 9,  "surface": "snow" },
    { "x": 302, "z": 152, "width": 9,  "surface": "snow" },
    { "x": 272, "z": 138, "width": 9,  "surface": "snow" },
    // 4 over the top
    { "x": 232, "z": 128, "width": 9,  "surface": "snow" },
    { "x": 224, "z": 108, "width": 9,  "surface": "snow" },
    { "x": 258, "z": 92,  "width": 10, "surface": "snow" },
    { "x": 276, "z": 70,  "width": 10, "surface": "snow" },
    { "x": 248, "z": 48,  "width": 12, "surface": "runway" },
    // 5 the airbase runway
    { "x": 190, "z": 42,  "width": 14, "surface": "runway" },
    { "x": 130, "z": 42,  "width": 14, "surface": "runway" },
    { "x": 75,  "z": 46,  "width": 12, "surface": "runway" },
    // 6 down the west side
    { "x": 42,  "z": 70,  "width": 10, "surface": "snow" },
    { "x": 34,  "z": 105, "width": 10, "surface": "snow" },
    { "x": 50,  "z": 130, "width": 11, "surface": "snow" },
    // 7 the frozen river, downstream (ice)
    { "x": 85,  "z": 140, "width": 13, "surface": "ice" },
    { "x": 125, "z": 158, "width": 13, "surface": "ice" },
    { "x": 160, "z": 180, "width": 13, "surface": "ice" },
    { "x": 190, "z": 205, "width": 13, "surface": "ice" },
    { "x": 205, "z": 228, "width": 12, "surface": "ice" },
    // 8 the river hairpin, back onto the bank
    { "x": 195, "z": 250, "width": 10, "surface": "snow" },
    { "x": 172, "z": 248, "width": 9,  "surface": "snow" },
    // 9 the bank and the gulag camp gate
    { "x": 150, "z": 228, "width": 9,  "surface": "snow" },
    { "x": 120, "z": 212, "width": 8,  "surface": "snow" },
    { "x": 92,  "z": 205, "width": 9,  "surface": "snow" },
    // 10 the last left onto the start straight
    { "x": 62,  "z": 215, "width": 10, "surface": "snow" },
    { "x": 45,  "z": 245, "width": 11, "surface": "snow" },
    { "x": 52,  "z": 275, "width": 12, "surface": "snow" }
