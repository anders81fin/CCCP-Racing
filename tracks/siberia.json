  "roadSmoothing": 10,
  // The valley gives the lap its long rise/fall; these broad snow-road shapes add suspension rhythm.
  "features": [
    { "type": "dip", "at": 205, "length": 52, "height": 0.65 },
    { "type": "crest", "at": 570, "length": 54, "height": 0.8 },
    { "type": "crest", "at": 825, "length": 50, "height": 0.65 },
    { "type": "dip", "at": 905, "length": 50, "height": 0.5 }
  ],
  // Ploughed snow piled high on both sides: run into it square and it stops the car, brush it and
  // it turns the car back onto the road.
  // An opening round the start line: the gate's posts and the KGB officers stand on swept ground.
  // ...and along the runway's north side the apron is open, so the MiKs can taxi onto it.
  "snowbanks": { "height": 1.3, "gap": 0.5, "except": [ { "from": 1352, "to": 14 }, { "from": 615, "to": 810, "side": "right" },
    // ...and through the labour camp, gate to gate: the yard is open.
    { "from": 1172, "to": 1243 },
    // ...and where the timber lorry went through it on the outside of the river hairpin.
    { "from": 1117, "to": 1133, "side": "left" },
    // Radar service spur on the south/left shoulder of the upper serpentine.
    { "from": 438, "to": 457, "side": "left" } ],
    // Along the runway's south side the plough pushed the bank out, clear of the edge lights.
    "widen": [ { "from": 626, "to": 794, "side": "left", "by": 3.5 } ] },
  // The highway strip on the plateau: markings, numbers and edge lights; the MiKs taxi out of the
  // east hangar, line up at the east end and take off westwards, downhill.
  // A MiK holds on the apron beside the strip while a snowplough is on it or within clearBehind metres of either end.
  // The fuel depot at the runway's west end, north of it on the flat by the west hangar.
  "depot": { "at": 790, "side": "right", "off": 11 },
  "runway": { "from": 630, "to": 790, "numbers": ["27", "09"], "clearBehind": 110 },
  // The GAI post at the far end of the runway, on the south side (the hangars, the Kozlik's guard
  // spot and the taxiway are on the north side): the posted limit is 90.
  "speedTrap": { "at": 770, "side": "left", "limit": 90 },
  // Two snowploughs on the lap: one ahead of the start going the race's way, one coming the other way.
  "ploughs": [ { "start": 420 }, { "start": 900, "against": true } ],
  // A labour detail marched out of the camp, trudging round with the race along the right-hand edge.
  "column": { "start": 1262, "prisoners": 8 },
  // Logs felled and stacked by the road for the timber lorry, and in the camp's yard.
  "logPiles": [
    { "at": 70,   "side": "left" },
    { "at": 200,  "side": "right" },
    { "at": 335,  "side": "left" },
    { "at": 520,  "side": "right" },
    { "at": 880,  "side": "right" },
    { "at": 1196, "side": "right", "out": 4 },
    { "at": 1222, "side": "left",  "out": 4 },
    { "at": 1290, "side": "left" },
    { "at": 1330, "side": "right" }
  ],
  // The bank road runs through the labour camp: a gate at each end, barracks either side, the wire.
  "gulag": { "from": 1172, "to": 1243 },
  // The airbase on the plateau north of the runway: a ploughed apron, two hangars, a MiK-21,
  // the windsock, the flag and the airmen's barracks; the taxiway runs along the apron's south
  // edge, clear of them.
  "pads": [ { "x0": 88, "z0": 6, "x1": 242, "z1": 30, "surface": "concrete" },
    // Radar on the eastern shoulder above the switchbacks: a modest raised foundation on the hill shoulder.
    { "x0": 265, "z0": 151, "x1": 275, "z1": 161, "surface": "concrete", "height": 9.5 } ],
  "props": [
    { "type": "hangar",    "x": 100, "z": 17, "rot": 0 },
    { "type": "hangar",    "x": 124, "z": 17, "rot": 0 },
    { "type": "balalaika", "x": 152, "z": 14, "rot": 200 },
    { "type": "windsock",  "x": 176, "z": 10 },
    { "type": "flagpole",  "x": 196, "z": 10 },
    { "type": "barracks",  "x": 224, "z": 16, "rot": 0 },
    { "type": "radar",     "x": 270, "z": 156, "rot": 180 },
    // The track's name on the start straight, south of the road (as KOLKHOZ NO.3 has its billboard).
    { "type": "billboard", "x": 140, "z": 303, "rot": 0, "text": "SIBLAG NO.2 FIVE YEARS IN FOUR" },
    // A timber lorry that ran wide in the river hairpin, ploughed through the bank and lies on its
    // side in the ditch just off the outside of the bend, still smoking (an obstacle).
    { "type": "lorrywreck", "x": 190, "z": 259.5, "rot": 110 }
  ],
  "babushkas": 6,
  "bushes": 250,
  "tufts": 600,
  // The frozen river from the north-west down to the south edge: the ice leg runs on it, the start
  // straight crosses it. The ice falls downstream; the road on it is the ice.
  "water": {
    "frozen": true,
    // A real river valley: broad snowy banks and eased road crossings, rather than an ice lip.
    "valleyDepth": 2.6,
    "valleyBankWidth": 30,
    "rivers": [ { "points": [ [0, 96], [50, 122], [90, 142], [130, 162], [165, 186], [195, 214], [212, 245], [218, 280], [222, 322] ], "width": 16 } ]
